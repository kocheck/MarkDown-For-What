{
  "name": "markdown-for-what",
  "version": "1.0.0",
  "description": "Figma plugin to sync markdown files to text layers",
  "license": "ISC",
  "scripts": {
    "build": "webpack --mode=production",
    "watch": "webpack --mode=development --watch",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "lint": "eslint . --ext .ts",
    "lint:fix": "eslint . --ext .ts --fix",
    "format": "prettier --write 'src/**/*.ts' '*.ts'"
  },
  "dependencies": {
    "marked": "^4.3.0"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "prettier": "^3.2.0",
    "@figma/plugin-typings": "^1.121.0",
    "@types/jest": "^30.0.0",
    "@types/marked": "^4.3.0",
    "css-loader": "^6.8.1",
    "html-inline-script-webpack-plugin": "^3.2.1",
    "html-webpack-plugin": "^5.5.3",
    "jest": "^30.2.0",
    "style-loader": "^3.3.3",
    "ts-jest": "^29.4.6",
    "ts-loader": "^9.4.4",
    "typescript": "^5.1.6",
    "webpack": "^5.88.2",
    "webpack-cli": "^5.1.4"
  }
}
