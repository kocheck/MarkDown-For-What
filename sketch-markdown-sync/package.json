{
  "name": "sketch-markdown-for-what",
  "version": "1.0.0",
  "description": "Sketch plugin to import Markdown files as styled artboards",
  "license": "ISC",
  "skpm": {
    "name": "MarkDown For What",
    "manifest": "src/manifest.json",
    "main": "sketch-markdown-sync.sketchplugin"
  },
  "scripts": {
    "build": "skpm-build",
    "watch": "skpm-build --watch",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "lint": "eslint . --ext .ts",
    "lint:fix": "eslint . --ext .ts --fix",
    "format": "prettier --write 'src/**/*.ts'",
    "postinstall": "npm run build"
  },
  "dependencies": {
    "marked": "^4.3.0",
    "sketch-module-web-view": "^3.4.1"
  },
  "devDependencies": {
    "@skpm/builder": "^0.9.5",
    "@skpm/extract-loader": "^2.0.2",
    "@types/jest": "^29.5.14",
    "@types/marked": "^4.3.2",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "css-loader": "5.2.7",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "html-loader": "1.3.2",
    "jest": "^29.7.0",
    "prettier": "^3.2.0",
    "style-loader": "2.0.0",
    "ts-jest": "^29.4.6",
    "ts-loader": "8.0.5",
    "typescript": "^5.1.6"
  }
}
